# ====================================================================
# PANDUAN ENVIRONMENT VARIABLE FRONTEND TERPISAH (Vite & Next.js)
# ====================================================================

# --------------------------------------------------------------------
# 1. Untuk Project Frontend Berbasis VITE (React, Vue, Svelte, dsb.)
# Simpan di file .env atau .env.production pada root project frontend:
# --------------------------------------------------------------------
VITE_API_URL = http://localhost:8080
# Contoh saat hosting produksi:
# VITE_API_URL = https://api-grn.domainanda.com


# --------------------------------------------------------------------
# 2. Untuk Project Frontend Berbasis NEXT.JS
# Simpan di file .env.local atau .env.production pada root project frontend:
# --------------------------------------------------------------------
NEXT_PUBLIC_API_URL = http://localhost:8080
# Contoh saat hosting produksi:
# NEXT_PUBLIC_API_URL = https://api-grn.domainanda.com

