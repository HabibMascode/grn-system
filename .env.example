#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# production / development / testing
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP & BASE URL (BACKEND)
#--------------------------------------------------------------------
# URL publik backend tempat server CodeIgniter ini di-hosting
# Semua URL lampiran (file_surat, file_grn, berita_acara) akan otomatis mengacu ke baseURL ini.
# Contoh: https://api-grn.domainanda.com/
app.baseURL = 'http://localhost:8080/'
APP_BASE_URL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# CORS CONFIGURATION (Frontend Terpisah: Next.js, Vite, React, Vue)
#--------------------------------------------------------------------
# Domain frontend yang diizinkan melakukan request ke backend ini.
# Pisahkan dengan koma jika ada beberapa origin (misal: staging, produksi, lokal)
# Contoh: FRONTEND_URL = 'https://grn-frontend.vercel.app,http://localhost:5173'
FRONTEND_URL = 'http://localhost:5173,http://localhost:3000'

#--------------------------------------------------------------------
# DATABASE CONFIGURATION (TiDB Cloud / Cloud MySQL)
#--------------------------------------------------------------------
DB_HOST = gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT = 4000
DB_USER = your_tidb_username
DB_PASSWORD = your_tidb_password
DB_NAME = st_grn

# Pengaturan SSL/TLS (Wajib aktif untuk TiDB Cloud)
DB_SSL = true
DB_SSL_VERIFY = false
# DB_SSL_CA = '/path/to/isrgrootx1.pem'
# DB_SSL_KEY = ''
# DB_SSL_CERT = ''

# Konfigurasi fallback format CodeIgniter 4
database.default.hostname = gateway01.ap-southeast-1.prod.aws.tidbcloud.com
database.default.database = st_grn
database.default.username = your_tidb_username
database.default.password = your_tidb_password
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 4000

